From c36b4da55b62e1db566a5b8ccc002a5600698b0d Mon Sep 17 00:00:00 2001
From: Christoph Berliner <32103696+Styx85@users.noreply.github.com>
Date: Thu, 19 Nov 2026 10:25:33 +0100
Subject: [PATCH 1/4] vulkan: use 8-row FA blocks on GCN APUs also for large KV

The scalar flash attention path switches from 8 to 16 rows per block
once n_kv >= 1024. On a GCN APU (gfx90c, 7 CUs, RADV) the 16-row
variant is clearly slower, so prefill gets slower than necessary as
the context grows. Keep the reduced block rows for AMD GCN with UMA.

gfx90c, RADV, -fa 1, pp512 at depth 4096: Qwen3-0.6B Q4_K_M 324 -> 403
t/s, Qwen3-1.7B 224 -> 259, gemma-3-1b 717 -> 729; depth 0 and tg128
unchanged. FA op (hsk 128, 8 KV heads, GQA 2, nb 512): kv 1024 9.4 ->
6.6 ms, kv 4096 36.4 -> 26.3 ms. test-backend-ops FLASH_ATTN_EXT
(type_K=f16) 2931/2931.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 3674579..6d1c8a3 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -1236,7 +1236,10 @@ static vk_fa_tuning_params get_fa_tuning_params_scalar(const vk_device& device,
 
     const uint32_t D = hsk | hsv;
 
-    const bool reduce_block_rows = D & 8 || n_kv < 1024 || device->vendor_id == VK_VENDOR_ID_INTEL;
+    // GCN APUs (tested: gfx90c): 16-row blocks are slower than 8 rows also at large KV (prefill at 4k context +16-25%).
+    const bool gcn_apu = device->vendor_id == VK_VENDOR_ID_AMD && device->architecture == AMD_GCN && device->uma &&
+                         device->driver_id != vk::DriverId::eAmdProprietary;
+    const bool reduce_block_rows = D & 8 || n_kv < 1024 || device->vendor_id == VK_VENDOR_ID_INTEL || gcn_apu;
 
     if (n_rows == 1) {
         result.block_rows = 1;
