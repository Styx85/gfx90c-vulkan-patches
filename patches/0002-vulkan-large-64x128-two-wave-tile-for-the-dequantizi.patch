From 7633d851167fb0a620276ca5ef87156adb1704a6 Mon Sep 17 00:00:00 2001
From: Christoph Berliner <32103696+Styx85@users.noreply.github.com>
Date: Thu, 19 Nov 2026 10:30:34 +0100
Subject: [PATCH 2/4] vulkan: large 64x128 two-wave tile for the dequantizing
 matmul on GCN APUs

Without coopmat, AMD GPUs only use the small and medium matmul tiles.
On a GCN APU (gfx90c, 7 CUs, RADV) a 128-thread workgroup computing a
64x128 tile with two waves of 32x128 ({128, 64, 128, 32, 32, 128, 2,
4, 2, 1, 64}) is faster than the GCN medium tile for every quant type
tried, but only once n > 64 (at n = 64 half of it would be idle).

Use it as the large tile of the dequantizing matmul and enable the
large tile for quantized types on GCN APUs (UMA, RADV, subgroup 64, no
coopmat). The tile selector then keeps the medium tile for n <= 64.

gfx90c, test-backend-ops perf MUL_MAT m=4096 n=512 k=14336, TFLOPS:
q4_0 1.43 -> 1.93, q8_0 1.45 -> 1.90, q4_K 1.39 -> 1.88, q5_K 1.36 ->
1.85, q6_K 1.26 -> 1.65. llama-bench (-fa 1, Q4_K_M), Qwen3-1.7B /
gemma-3-1b, t/s: pp64 393 -> 393 / 691 -> 691, pp128 423 -> 483 /
775 -> 868, pp512 440 -> 547 / 835 -> 1014; Qwen3-0.6B pp512 1136 ->
1343. tg unchanged. test-backend-ops MUL_MAT 2600/2600.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 6d1c8a3..2b9b1ec 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -1943,6 +1943,12 @@ static bool ggml_vk_amd_large_tile_supported(const vk_device& device) {
     return major > 2 || (major == 2 && build >= 416);
 }
 
+// Large tile for the dequantizing (non integer dot) matmul on GCN APUs with RADV, see ggml_vk_load_shaders.
+static bool ggml_vk_gcn_apu_large_mmq_tile(const vk_device& device) {
+    return device->vendor_id == VK_VENDOR_ID_AMD && device->architecture == AMD_GCN && device->uma &&
+           device->driver_id != vk::DriverId::eAmdProprietary && device->subgroup_size == 64 && !device->coopmat_support;
+}
+
 void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     VK_LOG_DEBUG("ggml_vk_load_shaders(" << device->name << ")");
 
@@ -2132,6 +2138,13 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         m_align =  64;
         s_align =  32;
 
+        if (ggml_vk_gcn_apu_large_mmq_tile(device)) {
+            // GCN APUs (tested: gfx90c): 64x128 tile computed by two waves of 32x128 as large tile of the dequantizing
+            // matmul; it is selected for n > 64, smaller batches keep the GCN medium tile above.
+            l_warptile_mmq  = { 128, 64, 128, 32, 32, 128, 2, 4, 2, 1, 64 };
+            l_mmq_wg_denoms = { 64, 128, 1 };
+        }
+
         if (device->vendor_id == VK_VENDOR_ID_INTEL && device->coopmat_support) {
             // Xe1/Xe2/Xe3 with coopmat enabled - warptile performance tuning
             l_warptile = { 512, 128, 128, 16, mm_warp_8, 32, 2, tm_l, tn_l, tk_l, mm_warp_8 };
@@ -5293,7 +5306,8 @@ vk_device ggml_vk_get_device(size_t idx) {
             switch (device->vendor_id) {
 #ifndef GGML_VULKAN_RUN_TESTS
             case VK_VENDOR_ID_AMD:
-                device->mul_mat_l[i]    = device->coopmat_support && ggml_vk_amd_large_tile_supported(device);
+                device->mul_mat_l[i]    = (device->coopmat_support && ggml_vk_amd_large_tile_supported(device)) ||
+                                          (ggml_vk_gcn_apu_large_mmq_tile(device) && ggml_is_quantized((ggml_type) i));
                 device->mul_mat_m[i]    = true;
                 device->mul_mat_s[i]    = true;
                 device->mul_mat_id_l[i] = false;
-- 
